<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.MainActivity">

    <LinearLayout
        android:id="@+id/layout_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/purple"
        android:paddingStart="8dp"
        android:paddingTop="16dp"
        android:paddingEnd="8dp"
        android:paddingBottom="16dp"
        >

        <ImageView
            android:id="@+id/image_all"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:src="@drawable/ic_all_inclusive"
            />

        <ImageView
            android:id="@+id/image_happy"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:src="@drawable/ic_emoji_smile"
             />


        <ImageView
            android:id="@+id/image_sunny"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:src="@drawable/ic_light_mode"
            />

    </LinearLayout>


    <TextView
        android:id="@+id/text_user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/layout_appbar"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/cabin"
        android:text="Olá, Kotlin!"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/text_message_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/text_user_name"
        android:layout_centerInParent="true"
        android:layout_marginTop="190dp"
        android:fontFamily="@font/cabin"
        android:text="Riscos devem ser corridos,porque o maior perigo é não arriscar nada!"
        android:textAlignment="center"
        android:textSize="22sp"
        android:textStyle="bold" />

    <View
        android:id="@+id/view_separate1"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_below="@id/text_message_center"
        android:layout_centerInParent="true"
        android:layout_marginHorizontal="128dp"
        android:layout_marginTop="32dp"
        android:background="@color/dark_purple"
        android:elevation="10dp" />

    <Button
        android:id="@+id/button_new_phrase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/view_separate1"
        android:layout_marginHorizontal="128dp"
        android:layout_marginTop="240dp"
        android:backgroundTint="@color/dark_purple"
        android:fontFamily="@font/cabin"
        android:text="@string/new_phrase"
        android:textAllCaps="true" />

</RelativeLayout>